# Copia in .env e assegna valori locali. Non committare .env.

DATABASE_URL=postgresql://ubuntu@/ieol

# Obbligatoria fuori dallo sviluppo. Segreto di firma della sessione.
# Senza IEOL_SESSION_SECRET e senza SESSION_SECRET il processo rifiuta l'avvio.
IEOL_SESSION_SECRET=
# SESSION_SECRET=

# Il cookie di sessione è https-only. Impostare 1 solo per HTTP locale.
# IEOL_INSECURE_COOKIES=1

# Solo su una macchina di sviluppo. Abilita una chiave di sessione insicura
# incorporata nel codice e lo script scripts/seed_dev_users.py.
# Non impostare in produzione.
# IEOL_DEV=1

# Password dei quattro ruoli. Non possono coincidere con il nome del ruolo.
# Se l'utente manca e la variabile è vuota, non viene creato.
# Se la password attuale è il nome del ruolo, all'avvio viene sostituita
# (con questo valore, oppure con un segreto casuale non stampato se la variabile è vuota).
IEOL_SEED_ADMIN_PASSWORD=
IEOL_SEED_MAPPER_PASSWORD=
IEOL_SEED_OPERATOR_PASSWORD=
IEOL_SEED_APPROVER_PASSWORD=
